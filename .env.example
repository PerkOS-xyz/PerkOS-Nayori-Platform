NODE_ENV=development
HOST=0.0.0.0
PORT=8080
SERVICE_ORIGIN=http://localhost:8080
RELEASE_SHA=development
LOG_LEVEL=info

DATABASE_URL=postgresql://nayori:nayori-local-only@postgres:5432/nayori
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000

STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
STACKS_BROADCAST_TIMEOUT_MS=10000
STACKS_OBSERVATION_TIMEOUT_MS=10000
QUOTE_ISSUANCE_ENABLED=false
# Generate outside GitHub with: npm run quote:keygen
# QUOTE_SIGNING_PRIVATE_JWK_JSON={"kty":"OKP","crv":"Ed25519",...}
QUOTE_PREVIOUS_PUBLIC_JWKS_JSON={"keys":[]}
QUOTE_MAX_TTL_SECONDS=300
QUOTE_RATE_LIMIT_PER_MINUTE=60
PAYMENT_RATE_LIMIT_PER_MINUTE=60
PAYMENT_VERIFICATION_ENABLED=false
SETTLEMENT_ENABLED=false
RECONCILIATION_ENABLED=false
SETTLEMENT_MIN_CONFIRMATIONS=1
RECONCILIATION_BATCH_SIZE=25
RECONCILIATION_INTERVAL_MS=5000
RECONCILIATION_LEASE_MS=30000
DELIVERY_LEDGER_ENABLED=false
DELIVERY_RETRY_TTL_SECONDS=86400
OAUTH_ENABLED=false
# Use external after oauth.nayori.ai is deployed and probed. Embedded remains a rollback mode.
OAUTH_MODE=embedded
OAUTH_ISSUER_ORIGIN=https://oauth.nayori.ai
OAUTH_RESOURCE_ORIGIN=https://nayori.ai
OAUTH_JWKS_URI=https://oauth.nayori.ai/oauth/jwks.json
PARTNER_REGISTRATION_ENABLED=false
MCP_ENABLED=false
# Public resource-server runtime only. Keep disabled on the facilitator runtime.
PUBLIC_RESOURCE_ENABLED=false
PUBLIC_RESOURCE_URL=https://nayori.ai/api/v1
PUBLIC_RESOURCE_ROUTE_ID=nayori-capability-report
FACILITATOR_ORIGIN=https://facilitator.nayori.ai
# Provision on the facilitator and store only in the resource-server secret environment.
# FACILITATOR_MERCHANT_API_KEY=ny_mk_...
FACILITATOR_REQUEST_TIMEOUT_MS=10000
# Embedded mode only: generate a separate Ed25519 JWK; never reuse the quote-signing key.
# OAUTH_SIGNING_PRIVATE_JWK_JSON={"kty":"OKP","crv":"Ed25519",...}
OAUTH_PREVIOUS_PUBLIC_JWKS_JSON={"keys":[]}
OAUTH_ACCESS_TOKEN_TTL_SECONDS=300
PARTNER_CHALLENGE_TTL_SECONDS=300
SPONSORSHIP_ENABLED=false
