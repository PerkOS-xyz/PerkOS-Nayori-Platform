{
  "name": "@perkos/nayori-platform",
  "version": "0.6.0",
  "private": true,
  "description": "Private API and reconciliation platform for Nayori x402 payments on Stacks.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:production": "node dist/migrate.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "merchant:provision": "tsx src/provision-merchant.ts",
    "merchant:provision:production": "node dist/provision-merchant.js",
    "oauth:keygen": "tsx src/generate-oauth-key.ts",
    "partner:invite": "tsx src/provision-partner-invitation.ts",
    "partner:invite:production": "node dist/provision-partner-invitation.js",
    "quote:keygen": "tsx src/generate-quote-key.ts",
    "reconcile": "tsx src/reconcile-worker.ts",
    "reconcile:production": "node dist/reconcile-worker.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@perkos/agent-sdk": "0.3.2",
    "@stacks/encryption": "7.5.0",
    "@stacks/transactions": "7.5.0",
    "hono": "4.13.5",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
